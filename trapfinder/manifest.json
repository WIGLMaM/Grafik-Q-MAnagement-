{
  "manifest_version": 3,
  "name": "TrapFinder",
  "version": "2.4.0",
  "description": "Findet HTML-/Code-/Embed-, Custom-, Storyline- und Szenario-Blöcke sowie PDF/Word-Dateien und Videos in Articulate-Rise-Kursen, springt per Klick dorthin und erstellt ein Protokoll.",
  "action": {
    "default_title": "TrapFinder",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.articulate.com/*"
      ],
      "js": [
        "capture.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
